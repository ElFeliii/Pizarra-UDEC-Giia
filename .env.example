# Copia este archivo a .env y completa MOD_USERS: es lo único obligatorio.
# El resto tiene valores por omisión que sirven tal cual. Nunca subas .env al repositorio.

# OBLIGATORIA. Moderadores del panel /moderador, como "nombre:clave" separados por coma. Cada
# uno entra con la suya y sus acciones quedan firmadas con ese nombre.
# Las claves no están en el código a propósito: las credenciales se entregan por un canal separado.
#   MOD_USERS=Moderador 1:clave-uno,Moderador 2:clave-dos
MOD_USERS=

# Llave maestra opcional: sirve con cualquier nombre, para alguien del equipo que llegue sin
# credenciales. Mínimo 8 caracteres. Déjala vacía si no la necesitas.
# ATENCIÓN: las claves del evento son cortas a propósito, para dictarlas en el momento. Lo
# único que frena un ataque por fuerza bruta es el límite de intentos (5 seguidos y después
# uno por minuto por IP). Si el sitio va a quedar público más allá del evento, define
# MOD_USERS con claves largas.
MOD_PASSWORD=

# Firma las cookies de moderador. Si se deja vacía, el servidor genera una y la guarda en
# data/session-secret, así que no hay que hacer nada. Para fijarla a mano:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Para Docker detrás de un único proxy HTTPS local, con el puerto publicado solo en
# 127.0.0.1, confiar en un salto: el puente Docker puede llegar con una IP no loopback.
# Si la U usa otra cadena de proxies, ajustar las IP o los saltos con el administrador.
# Usar false para probar directamente sin proxy. El código usa loopback si no se configura.
TRUST_PROXY=1

# Reportes de usuarios distintos necesarios para ocultar automáticamente (0 = desactivado).
AUTO_HIDE_REPORTS=3

# Opcionales
# PORT=3000
# HOST=0.0.0.0
# DB_PATH=/app/data/pizarra.db
# NODE_ENV=production
